{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "functions": {
    "api/refresh.py": {
      "maxDuration": 300,
      "includeFiles": "{refresh.py,data/snapshot.json}"
    },
    "api/kill.py": {
      "maxDuration": 10,
      "includeFiles": "{refresh.py}"
    }
  }
}
